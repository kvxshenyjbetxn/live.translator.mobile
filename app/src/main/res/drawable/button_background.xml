<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="@color/button" /><corners android:radius="8dp" /></shape></item>
    <item android:state_selected="true"><shape><solid android:color="@color/surface" /><stroke android:width="2dp" android:color="@color/accent" /><corners android:radius="8dp" /></shape></item>
    <item><shape><solid android:color="@color/button" /><stroke android:width="1dp" android:color="@color/line" /><corners android:radius="8dp" /></shape></item>
</selector>
