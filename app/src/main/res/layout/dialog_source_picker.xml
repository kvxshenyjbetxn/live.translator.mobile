<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/card_background" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Джерело" android:textColor="?attr/ltAccent" android:textSize="18sp" android:textStyle="bold" />
    <EditText android:id="@+id/pickerSearch" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/button_background" android:hint="Пошук програми" android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="?attr/ltText" android:textColorHint="?attr/ltMuted" android:textSize="15sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1">
        <ListView android:id="@+id/pickerList" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:dividerHeight="0dp" android:scrollbarStyle="outsideOverlay" />
        <TextView android:id="@+id/pickerEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Нічого не знайдено" android:textColor="?attr/ltMuted" android:textSize="14sp" android:visibility="gone" />
    </FrameLayout>
    <Button android:id="@+id/pickerClose" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/button_background" android:text="Скасувати" android:textColor="?attr/ltText" />
</LinearLayout>
