<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/ltBackground">
    <LinearLayout android:id="@+id/pageRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/page_padding">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/button_background" android:contentDescription="@string/back" android:src="@drawable/ic_arrow_back" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:letterSpacing="0.15" android:text="@string/settings_eyebrow" android:textColor="@color/eyebrow" android:textSize="11sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="sans-serif-medium" android:text="@string/settings" android:textColor="?attr/ltText" android:textSize="26sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="24dp" android:text="@string/settings_autosave_note" android:textColor="?attr/ltMuted" android:textSize="13sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:background="@drawable/settings_card_background" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/connection_title" android:textColor="?attr/ltText" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="14dp" android:text="@string/connection_desc" android:textColor="?attr/ltMuted" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/api_key" android:textColor="@color/field_label" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <EditText android:id="@+id/apiKeyInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/input_background" android:hint="@string/api_key" android:inputType="textPassword" android:minHeight="48dp" android:padding="12dp" android:textColor="?attr/ltText" android:textColorHint="?attr/ltMuted" android:textSize="14sp" />
                <Button android:id="@+id/toggleKeyButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/button_background" android:contentDescription="Показати або сховати ключ" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Показати ключ" android:textAllCaps="false" android:textColor="?attr/ltText" android:textSize="13sp" />
            </LinearLayout>
            <Button android:id="@+id/checkButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/primary_button_background" android:fontFamily="sans-serif-medium" android:text="@string/check_connection" android:textAllCaps="false" android:textColor="?attr/ltAccentText" />
            <Button android:id="@+id/removeKeyButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@android:color/transparent" android:minWidth="0dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:text="@string/remove_key" android:textAllCaps="false" android:textColor="@color/text_button" android:textSize="13sp" />
            <TextView android:id="@+id/settingsStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:textColor="?attr/ltMuted" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/notice_background" android:lineSpacingMultiplier="1.5" android:paddingStart="15dp" android:paddingTop="13dp" android:paddingEnd="15dp" android:paddingBottom="13dp" android:text="@string/key_plaintext_warning" android:textColor="?attr/ltMuted" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingMultiplier="1.4" android:text="@string/free_tier_note" android:textColor="@color/subtle" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:background="@drawable/settings_card_background" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/sound_title" android:textColor="?attr/ltText" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="14dp" android:text="@string/sound_desc" android:textColor="?attr/ltMuted" android:textSize="12sp" />
            <TextView android:id="@+id/boostLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:textColor="@color/field_label" android:textSize="13sp" />
            <SeekBar android:id="@+id/boostSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="20" android:minHeight="48dp" android:progressBackgroundTint="?attr/ltLine" android:progressTint="?attr/ltAccent" android:thumbTint="?attr/ltAccent" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:lineSpacingMultiplier="1.4" android:text="@string/boost_hint" android:textColor="@color/subtle" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:background="@drawable/settings_card_background" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/appearance_title" android:textColor="?attr/ltText" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="14dp" android:text="@string/appearance_desc" android:textColor="?attr/ltMuted" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/theme_label" android:textColor="@color/field_label" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:orientation="horizontal">
                <Button android:id="@+id/themeDarkButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/button_background" android:minWidth="0dp" android:text="@string/theme_dark" android:textAllCaps="false" android:textColor="?attr/ltText" android:textSize="13sp" />
                <Button android:id="@+id/themeAmoledButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/button_background" android:minWidth="0dp" android:text="@string/theme_amoled" android:textAllCaps="false" android:textColor="?attr/ltText" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="@string/accent_label" android:textColor="@color/field_label" android:textSize="12sp" />
            <LinearLayout android:id="@+id/accentRowTop" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
            <LinearLayout android:id="@+id/accentRowBottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
            <Button android:id="@+id/resetAccentButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@android:color/transparent" android:minWidth="0dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:text="@string/accent_reset" android:textAllCaps="false" android:textColor="@color/text_button" android:textSize="13sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:lineSpacingMultiplier="1.4" android:text="@string/appearance_note" android:textColor="@color/subtle" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
